# Copie para .env e preencha. O arquivo .env nunca vai para o Git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pi2_tributario
DB_USER=pi2_app
DB_PASSWORD=
# Chave do HMAC-SHA-256 que pseudonimiza CPF/CNPJ: 64 caracteres hexadecimais (32 bytes, RFC 2104, §3).
# Ainda não é usada: o piloto não tem dados pessoais. Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONIMO_CHAVE=
# Banco usado pelos testes de integração (é recriado a cada execução)
DB_NAME_TESTE=pi2_tributario_teste

# ---- Coleta da Sprint 3 (etl_sefin.py) ----
# Cópia local da extração oficial NUCLEOGOV de 07/07/2026 (receita_acessoinformacao.csv), distribuída pela
# coordenação: é a fonte padrão da receita. Só é aceita se o hash Git conferir com o publicado (blob 449ca775...).
# Ex.: C:\Users\<usuario>\Downloads\receita_acessoinformacao.csv
PI2_NUCLEOGOV_ARQUIVO=
# User-Agent usado só no portal NUCLEOGOV, e só com --nucleogov-api (receita pela API do portal, até o mês
# corrente). O firewall do portal recusa User-Agents de biblioteca; o manual de coleta da coordenação
# (armadilha 5.1) trata o User-Agent de navegador como contorno legítimo. A escolha é do operador (ADR-002).
# Vazio = a API do portal não é consultada.
PI2_NUCLEOGOV_USER_AGENT=
# Contato opcional acrescentado ao User-Agent da coleta (identifica o coletor ao operador da fonte).
# Vazio = nenhum contato é enviado.
PI2_CONTATO_COLETA=
# Usado só com --nucleogov-github (opcional; sem token vale o limite anônimo da API do GitHub).
GITHUB_TOKEN=
